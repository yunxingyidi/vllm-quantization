#include "kernel_operator.h"
using namespace AscendC;

// Each token is owned by one vector core. Native routing supplies a bijection
// from (token, top-k slot) to expert-major output row.
extern "C" __global__ __vector__ void dispatch_quant_scatter_kernel(
    GM_ADDR x, GM_ADDR mapping, GM_ADDR y, GM_ADDR scales,
    uint32_t rows, uint32_t width, uint32_t topk)
{
    TPipe pipe;
    GlobalTensor<bfloat16_t> xGm;
    GlobalTensor<int32_t> mapGm;
    GlobalTensor<int8_t> yGm;
    GlobalTensor<float> scaleGm;
    xGm.SetGlobalBuffer((__gm__ bfloat16_t*)x);
    mapGm.SetGlobalBuffer((__gm__ int32_t*)mapping);
    yGm.SetGlobalBuffer((__gm__ int8_t*)y);
    scaleGm.SetGlobalBuffer((__gm__ float*)scales);
    TQue<QuePosition::VECIN, 1> inQueue, mapQueue;
    TQue<QuePosition::VECOUT, 1> outQueue, scaleQueue;
    TBuf<TPosition::VECCALC> valueBuf, scratchBuf, reduceBuf, halfBuf;
    pipe.InitBuffer(inQueue, 1, width * 2);
    pipe.InitBuffer(mapQueue, 1, ((topk + 7) / 8) * 32);
    pipe.InitBuffer(outQueue, 1, width);
    pipe.InitBuffer(scaleQueue, 1, 32);
    pipe.InitBuffer(valueBuf, width * 4);
    pipe.InitBuffer(scratchBuf, width * 4);
    pipe.InitBuffer(reduceBuf, width * 4);
    pipe.InitBuffer(halfBuf, width * 2);
    auto values = valueBuf.Get<float>();
    auto scratch = scratchBuf.Get<float>();
    auto reduction = reduceBuf.Get<float>();
    auto halfValues = halfBuf.Get<half>();
    for (uint32_t row = GetBlockIdx(); row < rows; row += GetBlockNum()) {
        auto input = inQueue.AllocTensor<bfloat16_t>();
        auto indices = mapQueue.AllocTensor<int32_t>();
        DataCopyPad(input, xGm[(uint64_t)row * width],
                    DataCopyExtParams{1, width * 2, 0, 0, 0},
                    DataCopyPadExtParams<bfloat16_t>{false, 0, 0, 0});
        DataCopyPad(indices, mapGm[(uint64_t)row * topk],
                    DataCopyExtParams{1, topk * 4, 0, 0, 0},
                    DataCopyPadExtParams<int32_t>{false, 0, 0, 0});
        inQueue.EnQue(input);
        mapQueue.EnQue(indices);
        input = inQueue.DeQue<bfloat16_t>();
        indices = mapQueue.DeQue<int32_t>();
        Cast(values, input, RoundMode::CAST_NONE, width);
        PipeBarrier<PIPE_V>();
        Abs(scratch, values, width);
        PipeBarrier<PIPE_V>();
        ReduceMax(reduction, scratch, scratch, width);
        event_t vToS = static_cast<event_t>(pipe.FetchEventID(HardEvent::V_S));
        SetFlag<HardEvent::V_S>(vToS);
        WaitFlag<HardEvent::V_S>(vToS);
        const float absMax = reduction.GetValue(0);
        const float scale = absMax / 127.0F;
        const float divisor = scale > 0.0F ? scale : 1.0F;
        Duplicate(scratch, divisor, width);
        PipeBarrier<PIPE_V>();
        Div(scratch, values, scratch, width);
        PipeBarrier<PIPE_V>();
        // Match native MoeInitRoutingV2's two-stage quantization: truncate
        // normalized FP32 to FP16, then round FP16 to INT8. Direct FP32 RINT
        // differs at half-integer boundaries and changed model PPL slightly.
        Cast(halfValues, scratch, RoundMode::CAST_TRUNC, width);
        PipeBarrier<PIPE_V>();
        auto quant = outQueue.AllocTensor<int8_t>();
        Cast(quant, halfValues, RoundMode::CAST_ROUND, width);
        outQueue.EnQue(quant);
        quant = outQueue.DeQue<int8_t>();
        auto scaleLocal = scaleQueue.AllocTensor<float>();
        scaleLocal.SetValue(0, scale);
        event_t scalarStore = static_cast<event_t>(pipe.FetchEventID(HardEvent::S_MTE3));
        SetFlag<HardEvent::S_MTE3>(scalarStore);
        WaitFlag<HardEvent::S_MTE3>(scalarStore);
        scaleQueue.EnQue(scaleLocal);
        scaleLocal = scaleQueue.DeQue<float>();
        event_t mteToS = static_cast<event_t>(pipe.FetchEventID(HardEvent::MTE2_S));
        SetFlag<HardEvent::MTE2_S>(mteToS);
        WaitFlag<HardEvent::MTE2_S>(mteToS);
        for (uint32_t slot = 0; slot < topk; ++slot) {
            int32_t destination = indices.GetValue(slot);
            if (destination >= 0 && (uint64_t)destination < (uint64_t)rows * topk) {
                DataCopyPad(yGm[(uint64_t)destination * width], quant,
                            DataCopyExtParams{1, width, 0, 0, 0});
                DataCopyPad(scaleGm[destination], scaleLocal,
                            DataCopyExtParams{1, 4, 0, 0, 0});
            }
        }
        event_t stored = static_cast<event_t>(pipe.FetchEventID(HardEvent::MTE3_S));
        SetFlag<HardEvent::MTE3_S>(stored);
        WaitFlag<HardEvent::MTE3_S>(stored);
        outQueue.FreeTensor(quant);
        scaleQueue.FreeTensor(scaleLocal);
        inQueue.FreeTensor(input);
        mapQueue.FreeTensor(indices);
    }
}
